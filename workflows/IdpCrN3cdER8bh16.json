        "genericAuthType": "httpBasicAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ \"SELECT id, productcode FROM Products WHERE productcode IN (\" + $('Process Order').first().json.line_items.map(l => \"'\" + l.sku + \"'\").join(\",\") + \");\" }}"
            }
          ]
        },
