    {
      "parameters": {
        "jsCode": "const ctx = $('Build Context').first().json;\nconst priced = $('Process Order').first().json;\nconst fmt = c => (c / 100).toFixed(2);\n\nreturn [{ json: {\n  order_id: ctx.order_id,\n  po_number: ctx.po_number,\n  customer_id: ctx.customer_id,\n  status: 'in process',\n  created_at: ctx.created_at,\n  currency: priced.currency,\n  line_items: priced.line_items.map(l => ({\n    sku: l.sku,\n    title: l.title,\n    quantity: l.quantity,\n    unit_price: fmt(l.unit_amount_cents),\n    line_total: fmt(l.line_total_cents),\n    lead_time: l.lead_time,\n    //crm_sales_order_id: so.id,\n    //crm_sales_order_no: so.salesorder_no\n  })),\n  student_count: $('Webhook').first().json.body.students?.length ?? 0,\n  total_amount: fmt(priced.total_cents)\n} }];"
      },
