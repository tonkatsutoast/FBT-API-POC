        "jsCode": "// Validate the VTiger Products query before anything is built from it.\n//\n// VTiger's query API is quietly tolerant in three separate ways, none of which\n// is an error at the transport level:\n//   * an unmatched lookup answers HTTP 200 with {\"success\": true, \"result\": []}\n//   * a column that does not exist comes back as \"\" instead of failing\n//   * responses are served as text/html, so the HTTP node may hand back the raw\n//     text under `data` rather than a parsed object under `body`\n// Every one of those would silently produce a sales order with no product on\n// its lines, so nothing downstream may proceed on an unverified lookup.\nconst raw = $input.first().json;\nconst wanted = [...new Set(\n  $('Process Order').first().json.line_items.map(l => String(l.product_number).trim())\n)];\n\nconst fail = (reason) => [{ json: { ok: false, lookup_error: reason } }];\n\n// Lookup Products requests responseFormat=json; fall back to parsing raw `data`\n// so that a node copied from elsewhere still fails loudly instead of silently.\nlet payload = raw.body !== undefined ? raw.body : raw.data;\nif (typeof payload === 'string') {\n  try {\n    payload = payload.trim() === '' ? null : JSON.parse(payload);\n  } catch {\n    payload = null;\n  }\n}\n\nif (raw.statusCode !== undefined && raw.statusCode !== 200) {\n  return fail(`VTiger Products query failed with HTTP ${raw.statusCode}${raw.statusMessage ? ' ' + raw.statusMessage : ''}`);\n}\nif (payload === null || typeof payload !== 'object') {\n  return fail('VTiger Products query returned a response that is not JSON');\n}\nif (payload.success !== true) {\n  return fail(`VTiger Products query was rejected: ${JSON.stringify(payload.error ?? payload)}`);\n}\nif (!Array.isArray(payload.result)) {\n  return fail('VTiger Products query returned no result array');\n}\nif (payload.result.length === 0) {\n  return fail(`VTiger has no Products matching: ${wanted.join(', ')}`);\n}\nif (payload.result.some(r => r.productname === undefined || r.productname === null)) {\n  return fail('VTiger response is missing the productname column');\n}\n\nconst byProductNumber = {};\nfor (const r of payload.result) {\n  const name = String(r.productname).trim();\n  if (name && r.id) byProductNumber[name] = r.id;\n}\n\nconst missing = wanted.filter(n => !byProductNumber[n]);\nif (missing.length) {\n  return fail(`Product Number(s) not found in VTiger Products: ${missing.join(', ')}`);\n}\n\nreturn [{ json: { ok: true, by_product_number: byProductNumber, matched_count: payload.result.length } }];"
      },
