      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"2-3 sentence summary\"\n    },\n    \"key_points\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3,\n      \"description\": \"up to 3 short bullets\"\n    },\n    \"why_it_matters\": {\n      \"type\": \"string\",\n      \"description\": \"one sentence on business or technical relevance\"\n    },\n    \"topics\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"e.g. NFC, RFID, BLE, payments, supply chain\"\n    },\n    \"relevance\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"high\",\n        \"medium\",\n        \"low\"\n      ]\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"key_points\",\n    \"why_it_matters\",\n    \"topics\",\n    \"relevance\"\n  ]\n}"
