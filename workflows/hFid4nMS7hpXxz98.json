        "jsCode": "const feeds = [\n  { source: 'RFID Journal', url: 'https://www.rfidjournal.com/feed/' },\n  { source: 'NFCW', url: 'https://www.nfcw.com/feed/' },\n  { source: 'Identiv', url: 'https://identiv.com/feed/' },\n  { source: 'MIT News IoT', url: 'https://news.mit.edu/topic/mitinternet-things-rss.xml' },\n];\nreturn feeds.map(f => ({ json: f }));"
