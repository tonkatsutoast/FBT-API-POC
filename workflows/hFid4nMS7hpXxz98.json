      "id": "5d52f87c-7c34-41a5-9cc0-16fc6fa899f7",
      "name": "Combine Summarized Articles",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        2176,
        -144
      ]
    },
    {
      "parameters": {
        "jsCode": "const articles = ($input.first().json.articles || []).filter(a => a && a.link);\nconst sourcesChecked = $('Feed List').all().map(i => i.json.source);\nconst today = $now.setZone('America/Los_Angeles');\nconst dateLong = today.toFormat('cccc, LLLL d, yyyy');\nconst dateShort = today.toFormat('LLL d, yyyy');\n\nconst esc = (s) => String(s == null ? \"\" : s)\n  .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\nconst rank = { high: 0, medium: 1, low: 2 };\nconst badgeColor = { high: \"#c0392b\", medium: \"#d68910\", low: \"#7f8c8d\" };\n\nconst fmtDate = (d) => {\n  if (!d) return \"\";\n  const dt = DateTime.fromISO(String(d));\n  if (dt.isValid) return dt.setZone(\"America/Los_Angeles\").toFormat(\"LLL d, yyyy h:mm a\");\n  const alt = DateTime.fromRFC2822(String(d));\n  return alt.isValid ? alt.setZone(\"America/Los_Angeles\").toFormat(\"LLL d, yyyy h:mm a\") : esc(d);\n};\n\nconst groups = {};\nfor (const a of articles) {\n  const s = a.source || \"Other\";\n  if (!groups[s]) groups[s] = [];\n  groups[s].push(a);\n}\n\nconst parts = [];\nparts.push(\"<!DOCTYPE html><html><body style=\\\"margin:0;padding:0;background:#f4f5f7;\\\">\");\nparts.push(\"<table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#f4f5f7;\\\"><tr><td align=\\\"center\\\" style=\\\"padding:20px 10px;\\\">\");\nparts.push(\"<table role=\\\"presentation\\\" width=\\\"640\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:640px;max-width:100%;background:#ffffff;border:1px solid #e1e4e8;font-family:Arial,Helvetica,sans-serif;color:#24292e;\\\">\");\nparts.push(\"<tr><td style=\\\"background:#1f3a5f;padding:20px 24px;\\\"><div style=\\\"font-size:22px;font-weight:bold;color:#ffffff;\\\">NFC / RFID / IoT Digest</div><div style=\\\"font-size:14px;color:#c8d6e5;padding-top:4px;\\\">\" + esc(dateLong) + \"</div></td></tr>\");\n\nfor (const source of Object.keys(groups).sort()) {\n  const list = groups[source].sort((x, y) => (rank[x.relevance] ?? 3) - (rank[y.relevance] ?? 3));\n  parts.push(\"<tr><td style=\\\"padding:20px 24px 4px 24px;\\\"><div style=\\\"font-size:17px;font-weight:bold;color:#1f3a5f;border-bottom:2px solid #1f3a5f;padding-bottom:4px;\\\">\" + esc(source) + \" (\" + list.length + \")</div></td></tr>\");\n  for (const a of list) {\n    const rel = (a.relevance || \"low\").toLowerCase();\n    const color = badgeColor[rel] || \"#7f8c8d\";\n    let html = \"<tr><td style=\\\"padding:12px 24px;border-bottom:1px solid #eeeeee;\\\">\";\n    html += \"<div style=\\\"font-size:16px;font-weight:bold;line-height:1.3;\\\"><a href=\\\"\" + esc(a.link) + \"\\\" style=\\\"color:#0b62c4;text-decoration:none;\\\">\" + esc(a.title) + \"</a></div>\";\n    html += \"<div style=\\\"font-size:12px;color:#6a737d;padding:4px 0 8px 0;\\\">\" + fmtDate(a.pubDate) + (a.creator ? \" &middot; \" + esc(a.creator) : \"\") + \" &middot; <span style=\\\"color:\" + color + \";font-weight:bold;text-transform:uppercase;\\\">\" + esc(rel) + \" relevance</span></div>\";\n    html += \"<div style=\\\"font-size:14px;line-height:1.5;\\\">\" + esc(a.summary) + \"</div>\";\n    const kps = Array.isArray(a.key_points) ? a.key_points : [];\n    if (kps.length) {\n      html += \"<ul style=\\\"margin:8px 0 8px 20px;padding:0;font-size:14px;line-height:1.5;\\\">\" + kps.map(k => \"<li style=\\\"margin:0 0 4px 0;\\\">\" + esc(k) + \"</li>\").join(\"\") + \"</ul>\";\n    }\n    if (a.why_it_matters) {\n      html += \"<div style=\\\"font-size:14px;line-height:1.5;background:#f6f8fa;border-left:3px solid #1f3a5f;padding:6px 10px;margin:6px 0;\\\"><strong>Why it matters:</strong> \" + esc(a.why_it_matters) + \"</div>\";\n    }\n    const topics = Array.isArray(a.topics) ? a.topics : [];\n    if (topics.length) {\n      html += \"<div style=\\\"padding-top:6px;\\\">\" + topics.map(t => \"<span style=\\\"display:inline-block;font-size:11px;color:#1f3a5f;background:#e8eef6;border:1px solid #c8d6e5;border-radius:3px;padding:2px 6px;margin:0 4px 4px 0;\\\">\" + esc(t) + \"</span>\").join(\"\") + \"</div>\";\n    }\n    html += \"</td></tr>\";\n    parts.push(html);\n  }\n}\n\nparts.push(\"<tr><td style=\\\"padding:16px 24px;background:#f6f8fa;font-size:12px;color:#6a737d;line-height:1.5;\\\">\" + articles.length + \" article\" + (articles.length === 1 ? \"\" : \"s\") + \" summarized.<br>Sources checked: \" + esc(sourcesChecked.join(\", \")) + \"</td></tr>\");\nparts.push(\"</table></td></tr></table></body></html>\");\n\nconst subject = \"Industry Digest \\u2013 \" + dateShort + \" \\u2013 \" + articles.length + \" new article\" + (articles.length === 1 ? \"\" : \"s\");\nreturn [{ json: { subject, html: parts.join(\"\"), articleCount: articles.length } }];"
      },
