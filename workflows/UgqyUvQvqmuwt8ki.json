      "parameters": {
        "jsCode": "const b = $json.body;\nif (!b) throw new Error('Webhook body is empty - check Content-Type: application/json');\n\nconst now = new Date();\nconst order_id = `TS-${now.toISOString().slice(0, 10).replace(/-/g, '')}-` +\n                 Math.random().toString(36).slice(2, 8).toUpperCase();\n\nreturn [{\n  json: {\n    ...b,                          // original order: customer_id, po_number, line_items, students\n    order_id,\n    created_at: now.toISOString()\n  }\n}];"
