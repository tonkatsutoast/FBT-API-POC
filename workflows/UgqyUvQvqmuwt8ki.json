    {
      "parameters": {
        "jsCode": "// paste bui// ---- Pilot constants (move to customer config later) ----\nconst VTIGER_ACCOUNT_ID = '11x000';   // Account webservice id (moduleIdxRecordId)\nconst ASSIGNED_USER_ID  = '19x1';     // from GET /me\nconst ADDRESS = { bill_street: 'TBD', ship_street: 'TBD' }; // confirm via /describe\n\nconst ctx    = $('Build Context').first().json;\nconst priced = $('Process Order').first().json;\nconst found  = $('Lookup Products').first().json.result ?? [];\n\nconst idBySku = new Map(found.map(p => [p.productcode, p.id]));\nconst missing = priced.line_items.filter(l => !idBySku.has(l.sku)).map(l => l.sku);\nif (missing.length) throw new Error(`SKUs missing in VTiger Products: ${missing.join(', ')}`);\n\nconst element = {\n  subject: `Order ${ctx.order_id}${ctx.po_number ? ' / PO ' + ctx.po_number : ''}`,\n  account_id: VTIGER_ACCOUNT_ID,\n  assigned_user_id: ASSIGNED_USER_ID,\n  sostatus: 'Created',\n  purchaseorder: ctx.po_number ?? '',\n  customerno: ctx.order_id,          // your order id as external reference\n  ...ADDRESS,\n  hdnTaxType: 'group',\n  LineItems: priced.line_items.map(l => ({\n    productid: idBySku.get(l.sku),\n    quantity: l.quantity,\n    listprice: (l.unit_amount_cents / 100).toFixed(2)\n  }))\n};\n\nreturn [{ json: { element: JSON.stringify(element) } }];ld-salesorder code here"
      },
