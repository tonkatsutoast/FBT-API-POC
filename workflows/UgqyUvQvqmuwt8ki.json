      "parameters": {
        "jsCode": "const order = $('Build Context').first().json;\nreturn (order.lineItems ?? []).flatMap(li =>\n  (li.personalizationData ?? []).map(s => ({\n    json: {\n      //order_id: order.order_id,\n      //sku: li.sku,\n      //jobName: li.jobName ?? '',\n      //group: s.group ?? '',\n      studentId: s.studentId,\n      firstName: s.firstName,\n      lastName: s.lastName\n    }\n  }))\n);"
