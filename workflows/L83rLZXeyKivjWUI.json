    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Catalog Admin</title>\n<style>\n  :root { --fg:#1f2328; --muted:#656d76; --line:#d0d7de; --bg:#fff; --soft:#f6f8fa; --accent:#0969da; --danger:#cf222e; --ok:#1a7f37; }\n  * { box-sizing: border-box; }\n  body { margin:0; font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; color:var(--fg); background:var(--bg); }\n  main { max-width: 980px; margin: 0 auto; padding: 24px 16px 48px; }\n  h1 { font-size: 20px; margin: 0 0 16px; }\n  h2 { font-size: 16px; margin: 0 0 12px; }\n  .card { border:1px solid var(--line); border-radius:8px; padding:16px; margin-bottom:16px; }\n  .row { display:flex; gap:8px; flex-wrap:wrap; align-items:end; }\n  label { display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--muted); }\n  input, textarea { font:inherit; color:var(--fg); border:1px solid var(--line); border-radius:6px; padding:6px 8px; background:var(--bg); }\n  input.wide { width: 420px; max-width: 100%; }\n  textarea { width:100%; min-height:420px; font-family: ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12.5px; }\n  button { font:inherit; border:1px solid var(--line); background:var(--soft); border-radius:6px; padding:6px 12px; cursor:pointer; }\n  button.primary { background:var(--accent); border-color:var(--accent); color:#fff; }\n  button.danger { color:var(--danger); }\n  button:disabled { opacity:.5; cursor:default; }\n  table { width:100%; border-collapse:collapse; }\n  th, td { text-align:left; padding:8px; border-bottom:1px solid var(--line); }\n  th { font-size:12px; color:var(--muted); font-weight:600; }\n  td.actions { text-align:right; white-space:nowrap; }\n  .msg { margin-top:10px; font-size:13px; white-space:pre-wrap; }\n  .msg.error { color:var(--danger); }\n  .msg.ok { color:var(--ok); }\n  .hidden { display:none; }\n  .muted { color:var(--muted); }\n</style>\n</head>\n<body>\n<main>\n  <h1>Catalog Admin</h1>\n\n  <section class=\"card\">\n    <h2>Connection</h2>\n    <div class=\"row\">\n      <label>Webhook base URL\n        <input id=\"base\" class=\"wide\" value=\"https://YOUR-INSTANCE.app.n8n.cloud/webhook\">\n      </label>\n      <label>Admin key\n        <input id=\"key\" type=\"password\" placeholder=\"X-Admin-Key value\">\n      </label>\n      <button class=\"primary\" id=\"connect\">Connect</button>\n    </div>\n    <div id=\"connMsg\" class=\"msg muted\">Use the production webhook URL (the workflow must be active).</div>\n  </section>\n\n  <section class=\"card\" id=\"listCard\">\n    <div class=\"row\" style=\"justify-content:space-between; margin-bottom:8px;\">\n      <h2 style=\"margin:0\">Catalogs</h2>\n      <div class=\"row\">\n        <button id=\"refresh\">Refresh</button>\n        <button class=\"primary\" id=\"newBtn\">New catalog</button>\n      </div>\n    </div>\n    <table>\n      <thead><tr><th>Customer ID</th><th>Products</th><th>Last updated</th><th></th></tr></thead>\n      <tbody id=\"rows\"><tr><td colspan=\"4\" class=\"muted\">Not connected.</td></tr></tbody>\n    </table>\n    <div id=\"listMsg\" class=\"msg\"></div>\n  </section>\n\n  <section class=\"card hidden\" id=\"editCard\">\n    <h2 id=\"editTitle\">Edit catalog</h2>\n    <div class=\"row\" style=\"margin-bottom:10px;\">\n      <label>Customer ID\n        <input id=\"custId\" type=\"number\" min=\"1\" step=\"1\">\n      </label>\n    </div>\n    <label>Products (JSON array)\n      <textarea id=\"json\" spellcheck=\"false\"></textarea>\n    </label>\n    <div class=\"row\" style=\"margin-top:10px;\">\n      <button id=\"validateBtn\">Validate &amp; format</button>\n      <button class=\"primary\" id=\"saveBtn\">Save</button>\n      <button id=\"cancelBtn\">Cancel</button>\n    </div>\n    <div id=\"editMsg\" class=\"msg\"></div>\n  </section>\n</main>\n\n<script>\n(() => {\n  const $ = id => document.getElementById(id);\n  let adminKey = '';\n  let catalogs = [];\n  let editingExisting = false;\n\n  const TEMPLATE = [\n    {\n      \"Title\": \"New Product\",\n      \"SKU\": \"SKU-001\",\n      \"Description\": \"\",\n      \"Lead Time\": \"\",\n      \"Minimum Order\": 1,\n      \"Pricing\": {\n        \"tiers_mode\": \"volume\",\n        \"tiers\": [\n          { \"up_to\": 499, \"unit_amount_cents\": 100 },\n          { \"up_to\": null, \"unit_amount_cents\": 80 }\n        ]\n      }\n    }\n  ];\n\n  const esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n  const base = () => $('base').value.trim().replace(/\\/+$/, '');\n  const setMsg = (id, text, kind) => { const el = $(id); el.textContent = text || ''; el.className = 'msg' + (kind ? ' ' + kind : ''); };\n\n  async function api(method, path, body) {\n    const headers = { 'X-Admin-Key': adminKey };\n    if (body !== undefined) headers['Content-Type'] = 'application/json';\n    const res = await fetch(base() + '/' + path, { method, headers, body: body !== undefined ? JSON.stringify(body) : undefined });\n    const text = await res.text();\n    let data = null;\n    try { data = text ? JSON.parse(text) : null; } catch { data = text; }\n    if (!res.ok) {\n      const detail = data && typeof data === 'object' ? (data.error || data.message) : data;\n      throw new Error(`${res.status}: ${detail || res.statusText}`);\n    }\n    return data;\n  }\n\n  // Same rules as the server-side \"Validate Catalog\" node\n  function validate(products) {\n    const errors = [];\n    if (!Array.isArray(products) || products.length === 0) return ['Catalog must be a non-empty JSON array of products'];\n    const seen = new Set();\n    products.forEach((p, i) => {\n      const at = `Product ${i + 1}${p && p.SKU ? ` (${p.SKU})` : ''}`;\n      if (!p || typeof p !== 'object') { errors.push(`${at}: must be an object`); return; }\n      if (!p.SKU || typeof p.SKU !== 'string') errors.push(`${at}: SKU is required`);\n      else if (seen.has(p.SKU)) errors.push(`${at}: duplicate SKU`);\n      else seen.add(p.SKU);\n      if (!p.Title) errors.push(`${at}: Title is required`);\n      if (p['Minimum Order'] != null && (!Number.isInteger(p['Minimum Order']) || p['Minimum Order'] < 1))\n        errors.push(`${at}: Minimum Order must be a positive integer`);\n      const t = p.Pricing && p.Pricing.tiers;\n      if (!Array.isArray(t) || t.length === 0) { errors.push(`${at}: Pricing.tiers must be a non-empty array`); return; }\n      t.forEach((tier, j) => {\n        if (!Number.isInteger(tier.unit_amount_cents) || tier.unit_amount_cents < 0)\n          errors.push(`${at}: tier ${j + 1} unit_amount_cents must be a non-negative integer`);\n        const last = j === t.length - 1;\n        if (last && tier.up_to !== null) errors.push(`${at}: last tier must have up_to: null`);\n        if (!last) {\n          if (!Number.isInteger(tier.up_to)) errors.push(`${at}: tier ${j + 1} up_to must be an integer`);\n          else if (j > 0 && Number.isInteger(t[j - 1].up_to) && tier.up_to <= t[j - 1].up_to)\n            errors.push(`${at}: tiers must be in ascending up_to order`);\n        }\n      });\n    });\n    return errors;\n  }\n\n  function render() {\n    const tbody = $('rows');\n    if (!catalogs.length) { tbody.innerHTML = '<tr><td colspan=\"4\" class=\"muted\">No catalogs yet.</td></tr>'; return; }\n    tbody.innerHTML = catalogs\n      .slice()\n      .sort((a, b) => a.customer_id - b.customer_id)\n      .map(c => `<tr>\n        <td>${esc(c.customer_id)}</td>\n        <td>${esc(c.product_count)}</td>\n        <td>${c.updated_at ? esc(new Date(c.updated_at).toLocaleString()) : ''}</td>\n        <td class=\"actions\">\n          <button data-edit=\"${esc(c.customer_id)}\">Edit</button>\n          <button class=\"danger\" data-del=\"${esc(c.customer_id)}\">Delete</button>\n        </td></tr>`).join('');\n  }\n\n  async function loadList() {\n    setMsg('listMsg', 'Loading…');\n    try {\n      const data = await api('GET', 'admin/catalogs');\n      catalogs = Array.isArray(data) ? data : [];\n      render();\n      setMsg('listMsg', '');\n      setMsg('connMsg', 'Connected.', 'ok');\n    } catch (e) {\n      setMsg('listMsg', 'Could not load catalogs — ' + e.message, 'error');\n    }\n  }\n\n  function openEditor(customerId, products, existing) {\n    editingExisting = existing;\n    $('editTitle').textContent = existing ? `Edit catalog — customer ${customerId}` : 'New catalog';\n    $('custId').value = customerId ?? '';\n    $('custId').disabled = existing;\n    $('json').value = JSON.stringify(products, null, 2);\n    setMsg('editMsg', '');\n    $('editCard').classList.remove('hidden');\n    $('editCard').scrollIntoView({ behavior: 'smooth' });\n  }\n\n  function closeEditor() { $('editCard').classList.add('hidden'); }\n\n  function readEditor() {\n    let products;\n    try { products = JSON.parse($('json').value); }\n    catch (e) { return { errors: ['Invalid JSON — ' + e.message] }; }\n    const errors = validate(products);\n    const id = Number($('custId').value);\n    if (!Number.isInteger(id) || id < 1) errors.unshift('Customer ID must be a positive integer');\n    if (!editingExisting && catalogs.some(c => c.customer_id === id)) errors.unshift(`Customer ${id} already has a catalog — use Edit instead`);\n    return { id, products, errors };\n  }\n\n  $('connect').onclick = () => { adminKey = $('key').value; loadList(); };\n  $('refresh').onclick = loadList;\n  $('newBtn').onclick = () => openEditor('', TEMPLATE, false);\n  $('cancelBtn').onclick = closeEditor;\n\n  $('validateBtn').onclick = () => {\n    const { products, errors } = readEditor();\n    if (errors.length) { setMsg('editMsg', errors.join('\\n'), 'error'); return; }\n    $('json').value = JSON.stringify(products, null, 2);\n    setMsg('editMsg', `Valid — ${products.length} product(s).`, 'ok');\n  };\n\n  $('saveBtn').onclick = async () => {\n    const { id, products, errors } = readEditor();\n    if (errors.length) { setMsg('editMsg', errors.join('\\n'), 'error'); return; }\n    $('saveBtn').disabled = true;\n    setMsg('editMsg', 'Saving…');\n    try {\n      await api('POST', 'admin/catalog', { customer_id: id, products });\n      setMsg('editMsg', 'Saved.', 'ok');\n      await loadList();\n      closeEditor();\n    } catch (e) {\n      setMsg('editMsg', 'Save failed — ' + e.message, 'error');\n    } finally {\n      $('saveBtn').disabled = false;\n    }\n  };\n\n  $('rows').onclick = async ev => {\n    const editId = ev.target.getAttribute('data-edit');\n    const delId = ev.target.getAttribute('data-del');\n    if (editId) {\n      setMsg('listMsg', 'Loading catalog…');\n      try {\n        const products = await api('GET', 'admin/catalog?customer_id=' + encodeURIComponent(editId));\n        setMsg('listMsg', '');\n        openEditor(Number(editId), products, true);\n      } catch (e) { setMsg('listMsg', 'Could not load catalog — ' + e.message, 'error'); }\n    }\n    if (delId) {\n      if (!confirm(`Delete the catalog for customer ${delId}? Orders for this customer will be rejected until a new catalog is saved.`)) return;\n      try {\n        await api('DELETE', 'admin/catalog?customer_id=' + encodeURIComponent(delId));\n        await loadList();\n      } catch (e) { setMsg('listMsg', 'Delete failed — ' + e.message, 'error'); }\n    }\n  };\n})();\n</script>\n</body>\n</html>\n",
        "options": {}
      },
