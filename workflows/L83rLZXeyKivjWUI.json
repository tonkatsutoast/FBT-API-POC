    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst errors = [];\nconst id = Number(b.customer_id);\nif (!Number.isInteger(id) || id < 1) errors.push('customer_id must be a positive integer');\n\nconst products = b.products;\nif (!Array.isArray(products) || !products.length) errors.push('products must be a non-empty array');\n\nconst seen = new Set();\nfor (const [i, p] of (Array.isArray(products) ? products : []).entries()) {\n  const at = `Product ${i + 1}${p?.SKU ? ` (${p.SKU})` : ''}`;\n  if (!p?.SKU) errors.push(`${at}: SKU is required`);\n  else if (seen.has(p.SKU)) errors.push(`${at}: duplicate SKU`);\n  else seen.add(p.SKU);\n  if (!p?.Title) errors.push(`${at}: Title is required`);\n  const min = p?.['Minimum Order'];\n  if (min != null && (!Number.isInteger(min) || min < 1)) errors.push(`${at}: Minimum Order must be a positive integer`);\n  const t = p?.Pricing?.tiers;\n  if (!Array.isArray(t) || !t.length) { errors.push(`${at}: Pricing.tiers must be a non-empty array`); continue; }\n  t.forEach((tier, j) => {\n    if (!Number.isInteger(tier.unit_amount_cents) || tier.unit_amount_cents < 0) errors.push(`${at}: tier ${j + 1} price must be a non-negative integer (cents)`);\n    const last = j === t.length - 1;\n    if (last && tier.up_to !== null) errors.push(`${at}: last tier must have up_to: null`);\n    if (!last && !Number.isInteger(tier.up_to)) errors.push(`${at}: tier ${j + 1} up_to must be an integer`);\n    if (!last && j > 0 && tier.up_to <= t[j - 1].up_to) errors.push(`${at}: tiers must be ascending`);\n  });\n}\n\nreturn [{ json: { valid: errors.length === 0, errors, customer_id: id, catalog_json: JSON.stringify(products ?? []) } }];"
      },
