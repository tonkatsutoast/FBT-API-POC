      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const auth = $input.first().json;\n\n// api.authorize's terminal nodes don't return requestId, so read it from the\n// gate's own trigger input.\nconst requestId = $('When Executed by Another Workflow').first().json.requestId ?? null;\n\nif (auth.authorized === true) {\n  return [{\n    json: {\n      authorized: true,\n      customer: auth.customer ?? null,\n      requestId\n    }\n  }];\n}\n\nconst code = String(auth.reason ?? 'UNAUTHORIZED');\nconst statusCode = Number(auth.status) === 403 ? 403 : 401;\n\nconst messages = {\n  UNAUTHORIZED: 'Authentication failed.',\n  CUSTOMER_NOT_FOUND: 'The API key is not valid or has been revoked.',\n  CUSTOMER_ID_MISMATCH: 'The API key is valid, but the customer ID does not match.',\n  FORBIDDEN: 'The API key does not have the required scope.'\n};\n\nreturn [{\n  json: {\n    authorized: false,\n    statusCode,\n    requestId,\n    responseBody: {\n      error: {\n        code,\n        message: messages[code] ?? 'Authorization failed.',\n        retryable: false,\n        requestId,\n        details: []\n      }\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
