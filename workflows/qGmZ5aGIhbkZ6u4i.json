    {
      "parameters": {
        "jsCode": "const row = $('Lookup Customer').first().json;\n/**\nconst required = String(\n  $('When Executed by Another Workflow').first().json.required_scope ?? ''\n).trim();\n**/\nconst required = String(\n  $('Authenticate').first().json.required_scope ?? ''\n).trim();\nlet scopes = [];\ntry {\n  const parsed = JSON.parse(row.allowed_scopes ?? '[]');\n  if (Array.isArray(parsed)) scopes = parsed.map(String);\n} catch (e) {\n  scopes = [];               // fail closed\n}\n\nconst allowed = required !== '' && scopes.includes(required);\n\nreturn [{ json: {\n  ...row,\n  scopes,\n  required_scope: required,\n  scope_allowed: allowed\n} }];"
      },
