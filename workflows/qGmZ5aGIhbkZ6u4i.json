    {
      "parameters": {
        "jsCode": "// Parses the presented API key. Hashing happens in the Crypto node —\nconst out = [];\n\nfor (const item of $input.all()) {\n  const h = item.json.headers ?? {};\n  const raw =\n    h[\"x-api-key\"] ??\n    (typeof h[\"authorization\"] === \"string\"\n      ? h[\"authorization\"].replace(/^Bearer\\s+/i, \"\")\n      : undefined);\n  const key = typeof raw === \"string\" ? raw.trim() : \"\";\n  const ok = key.length >= 20;\n\n  out.push({\n    json: {\n      ...item.json,\n      auth: {\n        ok,\n        reason: ok ? undefined : \"MISSING_OR_SHORT_KEY\",\n        key_to_hash: key,\n        key_prefix: key.slice(0, 12),\n        presented_customer_id: item.json.body?.customerId ?? null,\n      },\n    },\n    binary: item.binary,\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -496,
        -64
      ],
