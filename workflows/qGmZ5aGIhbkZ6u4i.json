    {
      "parameters": {
        "jsCode": "const customer = $input.first().json;\n\nconst safeCustomer = {\n  customer_id: customer.customer_id,\n  vtiger_account_id: customer.vtiger_account_id,\n  vtiger_contact_id: customer.vtiger_contact_id,\n  vtiger_assigned_user_id: customer.vtiger_assigned_user_id,\n  stripe_customer_id: customer.stripe_customer_id,\n  is_active: customer.is_active,\n};\n\nreturn [{\n  json: {\n    authorized: true,\n    status: 200,\n    customer_id: customer.customer_id,\n    scopes: customer.scopes,\n    required_scope: customer.required_scope,\n    customer: safeCustomer\n  }\n}];"
      },
